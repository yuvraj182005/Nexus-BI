APP_NAME=NexusBI AI
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-32-byte-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://nexusbi:nexusbi@postgres:5432/nexusbi
REDIS_URL=redis://redis:6379/0
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=nexusbi
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads
DATASET_SYNC_MAX_BYTES=10485760
DATASET_PREVIEW_ROWS=100
CONNECTOR_SYNC_INTERVAL_MINUTES=60
CONNECTOR_CONNECTION_TIMEOUT_SECONDS=15
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOG_LEVEL=INFO
POSTGRES_DB=nexusbi
POSTGRES_USER=nexusbi
POSTGRES_PASSWORD=replace-with-a-strong-password
